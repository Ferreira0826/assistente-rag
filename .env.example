# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O .env NUNCA deve ser versionado (confira o .gitignore).
# ============================================================

# --- Camada de agente (function calling) ---

# Chave da API. Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-cole-sua-chave-aqui

# Modelo usado pelo agente.
# gpt-4o-mini atende bem e custa uma fração do gpt-4o.
MODELO_AGENTE=gpt-4o-mini

# Endpoint da API. Deixe VAZIO para usar a OpenAI padrao.
# O projeto e agnostico de fornecedor: qualquer API compativel
# com o formato da OpenAI funciona trocando so esta linha.
#   Groq   -> https://api.groq.com/openai/v1
#   Gemini -> https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama -> http://localhost:11434/v1
OPENAI_BASE_URL=

# --- OCR (usado pelo carregador de PDFs escaneados) ---
# Caminho do executavel do Tesseract no Windows.
TESSERACT_CMD=C:\Users\SEU_USUARIO\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
